generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "mysql"
    url      = env("DATABASE_URL")
}

enum ResourceCategory {
    CONVERTER
    DATASET
    PLAYGROUND
    API
    GUIDE
    UTILITY
    DOWNLOAD
}

enum ResourceStatus {
    DRAFT
    LIVE
    ARCHIVED
}

enum ResourceActionType {
    LINK
    INTERNAL
    TOOL
    DOCUMENTATION
}

enum ConversionStatus {
    PENDING
    PROCESSING
    COMPLETED
    FAILED
}

// ==========================================
// DEBATE SYSTEM ENUMS
// ==========================================

enum UserRole {
    SUPER_ADMIN
    ADMIN
    JUDGE_ADMIN
    HEAD_JUDGE
    JUDGE
    USER
}

enum AccessApprovalStatus {
    PENDING
    APPROVED
    RESTRICTED
    REJECTED
}

enum DebateEventStatus {
    DRAFT
    REGISTRATION
    ACTIVE
    COMPLETED
    ARCHIVED
}

enum DebateRoundStatus {
    SCHEDULED
    LIVE
    PAUSED
    SCORING
    COMPLETED
    CANCELLED
}

enum TeamSide {
    PRO
    CON
}

enum SpeechType {
    CONSTRUCTIVE
    CROSS_FIRE_1
    REBUTTAL
    CROSS_FIRE_2
    SUMMARY
    GRAND_CROSS_FIRE
    FINAL_FOCUS
}

enum GameType {
    TEST
    REAL
}

enum ResponseChoice {
    YES
    NO
    OTHER
}

enum StudyYearLevel {
    BACHELOR_1
    BACHELOR_2
    BACHELOR_3
    BACHELOR_4
    GRADUATE_1
    GRADUATE_2
    GRADUATE_3
    GRADUATE_4
    OTHER
}

enum JournalType {
    ELSEVIER
    SPRINGER_NATURE
    ACM
    IEEE
    GENERIC
}

enum LaTeXQuality {
    BASIC
    STANDARD
    PROFESSIONAL
    PUBLICATION
}

model Resource {
    id        String           @id @default(cuid())
    slug      String           @unique
    title     String
    tagline   String
    summary   String
    category  ResourceCategory
    status    ResourceStatus   @default(DRAFT)
    featured  Boolean          @default(false)
    metadata  Json?
    createdAt DateTime         @default(now())
    updatedAt DateTime         @updatedAt
    actions   ResourceAction[]
}

model ResourceAction {
    id          String             @id @default(cuid())
    resourceId  String
    label       String
    description String?
    type        ResourceActionType @default(LINK)
    url         String?
    config      Json?
    order       Int                @default(0)

    resource Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

    @@index([resourceId])
}

model ConversionJob {
    id           String           @id @default(cuid())
    resourceSlug String
    inputFormat  String
    outputFormat String
    status       ConversionStatus @default(PENDING)
    sourceName   String?
    sourceSize   Int?
    entryCount   Int?
    warningCount Int?
    errorCount   Int?
    durationMs   Int?
    errorMessage String?
    metadata     Json?
    createdAt    DateTime         @default(now())
    updatedAt    DateTime         @updatedAt

    @@index([resourceSlug])
}

model ShortUrl {
    id          String    @id @default(cuid())
    originalUrl String    @db.Text
    shortCode   String    @unique
    customSlug  String?   @unique
    clicks      Int       @default(0)
    createdAt   DateTime  @default(now())
    updatedAt   DateTime  @updatedAt
    expiresAt   DateTime?
    createdBy   String?
    isActive    Boolean   @default(true)

    // Analytics
    lastClickAt DateTime?
    metadata    Json?

    @@index([shortCode])
    @@index([customSlug])
    @@index([createdAt])
    @@index([isActive])
}

model DownloadableFile {
    id          String    @id @default(cuid())
    title       String
    description String?   @db.Text
    fileName    String
    filePath    String
    fileSize    Int?
    fileType    String?
    category    String?
    accessLevel String    @default("public") // public, protected, private
    password    String? // hashed password for protected files
    publicUntil DateTime? // file becomes protected after this time
    downloads   Int       @default(0)
    isActive    Boolean   @default(true)
    createdAt   DateTime  @default(now())
    updatedAt   DateTime  @updatedAt

    @@index([accessLevel])
    @@index([isActive])
    @@index([category])
    @@index([publicUntil])
}

model User {
    id             String    @id @default(cuid())
    email          String    @unique
    password       String? // bcrypt hashed (null for OAuth-only users)
    name           String
    role           UserRole  @default(USER)
    accessStatus   AccessApprovalStatus @default(APPROVED)
    isActive       Boolean   @default(true)
    canAccessHub   Boolean   @default(true)
    canAccessConference Boolean?
    canAccessAdmin Boolean?
    approvedBy     String?
    approvedAt     DateTime?
    accessNote     String?   @db.Text
    emailVerified  Boolean   @default(false)
    googleId       String?   @unique
    verifyToken    String?
    verifyTokenExp DateTime?
    roleChangedAt  DateTime? // set when admin changes this user's role
    createdAt      DateTime  @default(now())
    updatedAt      DateTime  @updatedAt
    sessions       Session[]

    // Debate relations
    createdEvents DebateEvent[]      @relation("EventCreator")
    judgeProfiles DebateJudge[]
    teamMembers   DebateTeamMember[]

    @@index([email])
    @@index([role])
}

model UserAccessAuditLog {
    id           String   @id @default(cuid())
    actorUserId  String
    actorEmail   String
    targetUserId String
    targetEmail  String
    targetName   String?
    action       String
    field        String?
    oldValue     String?  @db.Text
    newValue     String?  @db.Text
    note         String?  @db.Text
    createdAt    DateTime @default(now())

    @@index([targetUserId, createdAt])
    @@index([actorUserId, createdAt])
    @@index([createdAt])
}

model Session {
    id        String   @id @default(cuid())
    userId    String
    token     String   @unique
    expiresAt DateTime
    createdAt DateTime @default(now())

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([userId])
    @@index([token])
    @@index([expiresAt])
}

// LaTeX to Word Conversion Models
model Journal {
    id             String            @id @default(cuid())
    name           String // "Elsevier Medical Image Analysis", "IEEE TMI", etc.
    type           JournalType
    documentClass  String // "elsarticle", "sn-jnl", "acmart", "IEEEtran"
    classOptions   Json? // ["preprint", "12pt"], ["pdflatex", "sn-mathphys-num"]
    bibStyle       String? // "elsarticle-num", "ACM-Reference-Format"
    requiresLogo   Boolean           @default(false)
    logoPath       String?
    yamlTemplate   String? // Path to Pandoc YAML template
    detectionRegex String? // Regex pattern for auto-detection
    description    String?           @db.Text
    publisher      String? // "Elsevier", "Springer Nature", "ACM", "IEEE"
    isActive       Boolean           @default(true)
    createdAt      DateTime          @default(now())
    updatedAt      DateTime          @updatedAt
    conversions    LaTeXConversion[]

    @@index([type])
    @@index([documentClass])
    @@index([isActive])
}

model LaTeXConversion {
    id              String           @id @default(cuid())
    journalId       String?
    detectedJournal String? // Auto-detected journal name
    manualOverride  Boolean          @default(false) // User manually selected journal
    status          ConversionStatus @default(PENDING)
    quality         LaTeXQuality     @default(STANDARD)
    inputFileName   String
    inputFileSize   Int?
    outputFileName  String?
    outputFileSize  Int?
    documentClass   String? // Detected from .tex file
    bibEntryCount   Int?
    figureCount     Int?
    tableCount      Int?
    errorMessage    String?          @db.Text
    warningMessage  String?          @db.Text
    durationMs      Int?
    metadata        Json? // Font info, packages used, compilation warnings
    createdAt       DateTime         @default(now())
    updatedAt       DateTime         @updatedAt

    journal Journal? @relation(fields: [journalId], references: [id], onDelete: SetNull)

    @@index([journalId])
    @@index([status])
    @@index([createdAt])
}

model ConversionTemplate {
    id           String      @id @default(cuid())
    name         String // "Elsevier Publication", "IEEE Journal"
    journalType  JournalType
    yamlContent  String      @db.Text // Full YAML template content
    description  String?     @db.Text
    fontSettings Json? // {"main": "Times New Roman", "size": 12}
    spacing      Float?      @default(1.5)
    margins      Json? // {"top": "1in", "bottom": "1in"}
    isDefault    Boolean     @default(false)
    createdAt    DateTime    @default(now())
    updatedAt    DateTime    @updatedAt

    @@index([journalType])
    @@index([isDefault])
}

// ==========================================
// DEBATE SYSTEM MODELS
// ==========================================

model DebateEvent {
    id          String            @id @default(cuid())
    slug        String            @unique
    title       String // "Presidential Inter-City Winter Debate 2026"
    subtitle    String? // "Academic Excellence Committee (AEC)"
    organizer   String? // "Liberian Student Union in China (LSUIC)"
    status      DebateEventStatus @default(DRAFT)
    startDate   DateTime
    endDate     DateTime?
    location    String?
    description String?           @db.Text
    rules       String?           @db.Text
    minScore    Float             @default(4)
    maxScore    Float             @default(6)
    createdBy   String?
    createdAt   DateTime          @default(now())
    updatedAt   DateTime          @updatedAt

    creator User?         @relation("EventCreator", fields: [createdBy], references: [id], onDelete: SetNull)
    rounds  DebateRound[]
    teams   DebateTeam[]
    judges  DebateJudge[]

    @@index([slug])
    @@index([status])
    @@index([createdBy])
}

model DebateTeam {
    id      String  @id @default(cuid())
    eventId String
    name    String // "Chengdu City", "Hangzhou City"
    city    String?

    event      DebateEvent        @relation(fields: [eventId], references: [id], onDelete: Cascade)
    roundTeams DebateRoundTeam[]
    members    DebateTeamMember[]

    @@index([eventId])
}

model DebateTeamMember {
    id     String  @id @default(cuid())
    teamId String
    userId String?
    name   String
    role   String? // "1st Speaker", "2nd Speaker"

    team DebateTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
    user User?      @relation(fields: [userId], references: [id], onDelete: SetNull)

    @@index([teamId])
    @@index([userId])
}

model DebateRound {
    id        String            @id @default(cuid())
    eventId   String
    roundNum  Int // 1, 2, 3...
    title     String? // "Game Day 1 (Game 2)"
    topic     String // "Drug Addicts: Do they need help?"
    status    DebateRoundStatus @default(SCHEDULED)
    gameType  GameType          @default(REAL)
    startTime DateTime?
    endTime   DateTime?
    venue     String?

    // Timer settings
    timerEnabled      Boolean @default(true)
    speechDurationSec Int     @default(300) // default 5 min per speech
    prepTimeSec       Int     @default(60) // prep time between speeches

    // Audience votes (entered by head judge, not self-serve)
    audienceProVotes Int @default(0)
    audienceConVotes Int @default(0)

    // Pause: scoring suspended but round not ended
    pausedAt DateTime?
    pausedBy String? // userId who paused

    // Lock: once COMPLETED, no more edits
    completedAt DateTime?
    completedBy String? // userId who marked complete

    // Score lock deadline (set by ADMIN+): after this time judges cannot modify scores
    scoreLockDeadline DateTime?
    scoreLockSetBy    String? // userId who set the lock

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    event      DebateEvent       @relation(fields: [eventId], references: [id], onDelete: Cascade)
    roundTeams DebateRoundTeam[]
    judgeSlots JudgeSlot[]

    @@index([eventId])
    @@index([status])
    @@index([gameType])
}

model DebateRoundTeam {
    id          String   @id @default(cuid())
    roundId     String
    teamId      String
    side        TeamSide // PRO or CON for this round
    speaksFirst Boolean  @default(false)

    round  DebateRound   @relation(fields: [roundId], references: [id], onDelete: Cascade)
    team   DebateTeam    @relation(fields: [teamId], references: [id], onDelete: Cascade)
    scores SpeechScore[]

    @@unique([roundId, teamId])
    @@unique([roundId, side])
    @@index([roundId])
    @@index([teamId])
}

model DebateJudge {
    id           String    @id @default(cuid())
    eventId      String
    userId       String
    alias        String // "C-Doe", "Kolia", "Omario"
    isHeadJudge  Boolean   @default(false)
    inviteToken  String?   @unique // for pending account setup invites
    inviteEmail  String? // original invite email (before account created)
    inviteSentAt DateTime? // when invite was sent

    event DebateEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
    user  User        @relation(fields: [userId], references: [id], onDelete: Cascade)
    slots JudgeSlot[]

    @@unique([eventId, userId])
    @@index([eventId])
    @@index([userId])
}

model JudgeSlot {
    id            String  @id @default(cuid())
    roundId       String
    judgeId       String? // nullable: set to null when judge is removed but scores must be preserved
    position      Int // 1=J1, 2=J2, 3=J3
    isRoundHead   Boolean @default(false) // true = this judge is the head judge for THIS round
    // Snapshot of alias at time of removal (preserved for score display after detach)
    detachedAlias String?

    round  DebateRound   @relation(fields: [roundId], references: [id], onDelete: Cascade)
    judge  DebateJudge?  @relation(fields: [judgeId], references: [id], onDelete: SetNull)
    scores SpeechScore[]

    @@unique([roundId, position])
    @@index([roundId])
    @@index([judgeId])
}

model SpeechScore {
    id          String     @id @default(cuid())
    slotId      String
    roundTeamId String
    speechType  SpeechType
    totalScore  Float? // Auto-calculated sum of criteria (20-30)
    comment     String?    @db.Text
    isDraft     Boolean    @default(false) // true = live-sync only; false = judge pressed Submit
    isLocked    Boolean    @default(false)
    lockedAt    DateTime?
    createdAt   DateTime   @default(now())
    updatedAt   DateTime   @updatedAt

    slot      JudgeSlot       @relation(fields: [slotId], references: [id], onDelete: Cascade)
    roundTeam DebateRoundTeam @relation(fields: [roundTeamId], references: [id], onDelete: Cascade)
    criteria  CriteriaScore[]

    @@unique([slotId, roundTeamId, speechType])
    @@index([slotId])
    @@index([roundTeamId])
    @@index([speechType])
}

model CriteriaScore {
    id            String @id @default(cuid())
    speechScoreId String
    criteriaKey   String // "clarity_of_position", "argument_structure", etc.
    score         Float // 4.0 to 6.0

    speechScore SpeechScore @relation(fields: [speechScoreId], references: [id], onDelete: Cascade)

    @@unique([speechScoreId, criteriaKey])
    @@index([speechScoreId])
}

// ==========================================
// CONFERENCE MANAGEMENT SYSTEM
// ==========================================

enum ConfStatus {
    PLANNING
    ACTIVE
    COMPLETED
    CANCELLED
}

enum BudgetCat {
    FOOD
    BEVERAGE
    SUPPLIES
    LOGISTICS
    VENUE
    TRANSPORT
    MEDIA
    ENTERTAINMENT
    ADMIN
    MISC
}

enum BudgetStatus {
    DRAFT
    REVIEW
    APPROVED
    REJECTED
}

enum PayMethod {
    WECHAT
    ALIPAY
    BANK
    CASH
    OTHER
}

enum PayStatus {
    PENDING
    COMMITTEE_APPROVED
    APPROVED
    REJECTED
}

enum PaymentType {
    EXPENSE
    INCOME
}

enum DelStatus {
    REGISTERED
    CONFIRMED
    ATTENDED
    CANCELLED
}

enum MeetStatus {
    SCHEDULED
    IN_PROGRESS
    DONE
    CANCELLED
}

enum ConfMinutesStatus {
    NONE
    DRAFT
    PENDING_APPROVAL
    APPROVED
    CHANGES_REQUESTED
}

enum ConfRole {
    CHAIR
    VICE_CHAIR
    SECRETARY
    TREASURER
    COMMITTEE
    DELEGATE
}

enum Gender {
    MALE
    FEMALE
}

enum RoomPref {
    PAIR
    SINGLE
}

enum PairReqType {
    STANDARD_PAIR
    LEGAL_PARTNER
    SINGLE_ROOM
}

enum PairReqStatus {
    PENDING
    ACCEPTED
    DECLINED
    CHAIR_APPROVED
    CHAIR_REJECTED
    CANCELLED
}

enum RoomAssignStatus {
    PENDING
    ASSIGNED
    CANCELLED
}

model ConfEvent {
    id        String     @id @default(cuid())
    name      String // "LSUIC 20th Anniversary National Conference"
    slug      String     @unique
    year      Int
    city      String
    venue     String
    venueCn   String? // Chinese name
    address   String?
    startsAt  DateTime
    endsAt    DateTime
    xrRate    Float      @default(7.2) // ¥ to $ exchange rate
    status    ConfStatus @default(PLANNING)
    deposit   Float? // Deposit amount paid
    createdAt DateTime   @default(now())
    updatedAt DateTime   @updatedAt

    budgets    ConfBudget[]
    delegates  ConfDelegate[]
    meetings   ConfMeeting[]
    members    ConfMember[]
    timeline   ConfTimeline[]
    payments   ConfPayment[]
    pairRequests ConfPairRequest[]
    roomAssignments ConfRoomAssignment[]
    financeAuditLogs ConfFinanceAuditLog[]
    reports    ConfReport[]

    @@index([slug])
    @@index([status])
}

model ConfMember {
    id        String   @id @default(cuid())
    confId    String
    userId    String? // Optional link to User account
    name      String
    role      ConfRole @default(COMMITTEE)
    city      String?
    phone     String?
    email     String?
    title     String? // "Cooking Chair", "Sports Chair", etc.
    photoPath String?
    photoFileName String?
    isActive  Boolean  @default(true)
    joinedAt  DateTime @default(now())
    updatedAt DateTime @updatedAt

    // Committee scope & permissions
    committeeScope      String?  // "Cooking", "Sports", "Logistics", "Media", "Transport", etc.
    canAssignCommittee  Boolean  @default(false) // Chair can assign members within their scope
    canApprovePayments  Boolean  @default(false) // Can perform Level-1 approval

    conf    ConfEvent    @relation(fields: [confId], references: [id], onDelete: Cascade)
    budgets ConfBudget[] @relation("BudgetCreator")
    submittedPayments   ConfPayment[] @relation("PaymentSubmitter")
    committeeApprovals  ConfPayment[] @relation("CommitteeApprover")

    @@index([confId])
    @@index([userId])
    @@index([committeeScope])
}

model ConfBudget {
    id         String       @id @default(cuid())
    confId     String
    createdBy  String // ConfMember id
    title      String // "Cooking Committee Budget"
    category   BudgetCat    @default(FOOD)
    status     BudgetStatus @default(DRAFT)
    notes      String?      @db.Text
    approvedBy String?
    approvedAt DateTime?
    createdAt  DateTime     @default(now())
    updatedAt  DateTime     @updatedAt

    conf     ConfEvent        @relation(fields: [confId], references: [id], onDelete: Cascade)
    creator  ConfMember       @relation("BudgetCreator", fields: [createdBy], references: [id])
    items    ConfBudgetItem[]
    payments ConfPayment[]

    @@index([confId])
    @@index([createdBy])
    @@index([status])
}

model ConfBudgetItem {
    id        String   @id @default(cuid())
    budgetId  String
    no        Int // display order number
    name      String
    desc      String?
    qty       Float
    unit      String // "KG", "carton", "pcs", "days"
    unitPrice Float // in ¥ RMB always
    notes     String?
    isPaid    Boolean  @default(false)
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    // computed: total = qty × unitPrice (done in app layer)
    budget   ConfBudget    @relation(fields: [budgetId], references: [id], onDelete: Cascade)
    payments ConfPayment[]

    @@index([budgetId])
}

model ConfPayment {
    id         String      @id @default(cuid())
    confId     String
    budgetId   String?
    itemId     String?
    amount     Float // in ¥ RMB
    paidBy     String // name of payer
    paidTo     String? // payee name
    method     PayMethod   @default(WECHAT)
    ref        String? // transaction reference
    note       String?     @db.Text
    status     PayStatus   @default(PENDING)
    approvedBy String?
    approvedAt DateTime?
    paidAt     DateTime    @default(now())
    createdAt  DateTime    @default(now())
    updatedAt  DateTime    @updatedAt

    // Payment type & income tracking
    paymentType  PaymentType @default(EXPENSE)
    incomeSource String? // For INCOME: "Fundraising", "Donation", "Sponsorship", etc.

    // Committee scoping
    committeeScope      String? // "Cooking", "Sports", "Logistics", etc.
    submittedByMemberId String? // ConfMember who submitted

    // Two-tier approval
    committeeApprovedBy String? // ConfMember id (Level-1 approval)
    committeeApprovedAt DateTime?
    isLocked            Boolean  @default(false) // true once finally approved — immutable

    conf      ConfEvent       @relation(fields: [confId], references: [id], onDelete: Cascade)
    budget    ConfBudget?     @relation(fields: [budgetId], references: [id], onDelete: SetNull)
    item      ConfBudgetItem? @relation(fields: [itemId], references: [id], onDelete: SetNull)
    proofs    ConfPaymentProof[]
    submittedBy    ConfMember? @relation("PaymentSubmitter", fields: [submittedByMemberId], references: [id], onDelete: SetNull)
    committeeApprover ConfMember? @relation("CommitteeApprover", fields: [committeeApprovedBy], references: [id], onDelete: SetNull)
    reportEntries  ConfReportEntry[]

    @@index([confId])
    @@index([budgetId])
    @@index([status])
    @@index([paymentType])
    @@index([committeeScope])
    @@index([isLocked])
}

model ConfPaymentProof {
    id         String   @id @default(cuid())
    paymentId  String
    fileName   String
    filePath   String
    fileSize   Int?
    fileType   String? // "image/png", "image/jpeg"
    uploadedBy String?
    createdAt  DateTime @default(now())

    payment ConfPayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

    @@index([paymentId])
}

model ConfDelegate {
    id           String    @id @default(cuid())
    confId       String
    userId       String?
    name         String
    passportNo   String?
    gender       Gender?
    delegateCode String?   @unique
    email        String?
    university   String?
    province     String?
    city         String
    phone        String?
    wechat       String?
    attendanceIntent ResponseChoice?
    travelAssistanceNeeded ResponseChoice?
    schoolCommunicationNeeded ResponseChoice?
    schoolCommunicationDetails String? @db.Text
    studyYear    StudyYearLevel?
    bringingForeignGuest ResponseChoice?
    guestNationality String?
    accommodationNeeded ResponseChoice?
    dietaryNeeds ResponseChoice?
    dietaryDetails String? @db.Text
    additionalComments String? @db.Text
    passportPhotoPath String?
    bookletPhotoPath  String?
    arrival      DateTime?
    departure    DateTime?
    accommodated Boolean   @default(false)
    feeAmount    Float? // Registration fee
    feePaid      Boolean   @default(false)
    roomPref     RoomPref  @default(PAIR)
    partnerClaimNote String? @db.Text
    wantsSingleRoom Boolean @default(false)
    flyerReady   Boolean   @default(false)
    flyerIssuedAt DateTime?
    status       DelStatus @default(REGISTERED)
    createdAt    DateTime  @default(now())
    updatedAt    DateTime  @updatedAt

    conf ConfEvent @relation(fields: [confId], references: [id], onDelete: Cascade)
    sentPairRequests ConfPairRequest[] @relation("PairRequester")
    receivedPairRequests ConfPairRequest[] @relation("PairTarget")
    roomAsA ConfRoomAssignment? @relation("RoomOccupantA")
    roomAsB ConfRoomAssignment? @relation("RoomOccupantB")

    @@index([confId])
    @@index([status])
    @@index([city])
    @@index([gender])
    @@index([feePaid])
}

model ConfPairRequest {
    id         String       @id @default(cuid())
    confId     String
    requesterId String
    targetId   String?
    requestType PairReqType @default(STANDARD_PAIR)
    status     PairReqStatus @default(PENDING)
    note       String?      @db.Text
    adminNote  String?      @db.Text
    respondedAt DateTime?
    createdAt  DateTime     @default(now())
    updatedAt  DateTime     @updatedAt

    conf      ConfEvent    @relation(fields: [confId], references: [id], onDelete: Cascade)
    requester ConfDelegate @relation("PairRequester", fields: [requesterId], references: [id], onDelete: Cascade)
    target    ConfDelegate? @relation("PairTarget", fields: [targetId], references: [id], onDelete: SetNull)

    @@index([confId, status])
    @@index([requesterId])
    @@index([targetId])
}

model ConfRoomAssignment {
    id          String           @id @default(cuid())
    confId      String
    roomCode    String
    occupantAId String
    occupantBId String?
    status      RoomAssignStatus @default(PENDING)
    isManual    Boolean          @default(false)
    overrideReason String?       @db.Text
    createdAt   DateTime         @default(now())
    updatedAt   DateTime         @updatedAt

    conf      ConfEvent    @relation(fields: [confId], references: [id], onDelete: Cascade)
    occupantA ConfDelegate @relation("RoomOccupantA", fields: [occupantAId], references: [id], onDelete: Cascade)
    occupantB ConfDelegate? @relation("RoomOccupantB", fields: [occupantBId], references: [id], onDelete: SetNull)

    @@unique([confId, roomCode])
    @@unique([occupantAId])
    @@unique([occupantBId])
    @@index([confId, status])
}

model ConfMeeting {
    id        String     @id @default(cuid())
    confId    String
    title     String // "Weekly Committee Meeting #1"
    meetingNo Int
    scheduled DateTime
    location  String? // "Online - WeChat" or venue room
    agenda    String?    @db.Text
    minutes   String?    @db.Text
    minutesStatus ConfMinutesStatus @default(NONE)
    minutesSubmittedBy String?
    chairNote String?    @db.Text
    minutesApprovedBy String?
    minutesApprovedAt DateTime?
    status    MeetStatus @default(SCHEDULED)
    createdAt DateTime   @default(now())
    updatedAt DateTime   @updatedAt

    conf ConfEvent @relation(fields: [confId], references: [id], onDelete: Cascade)

    @@index([confId])
    @@index([scheduled])
    @@index([status])
    @@unique([confId, meetingNo])
}

model ConfTimeline {
    id          String    @id @default(cuid())
    confId      String
    clientId    String?
    title       String // "Committee Formation", "Budget Deadline"
    description String?   @db.Text
    responsibleLead String? @db.Text
    date        DateTime
    endDate     DateTime?
    category    String? // "planning", "registration", "event", "post-event"
    isCritical  Boolean   @default(false)
    isCompleted Boolean   @default(false)
    completedAt DateTime?
    sortOrder   Int       @default(0)
    createdAt   DateTime  @default(now())
    updatedAt   DateTime  @updatedAt

    conf ConfEvent @relation(fields: [confId], references: [id], onDelete: Cascade)

    @@index([confId])
    @@index([date])
    @@index([category])
    @@unique([confId, clientId])
}

// ==========================================
// CONFERENCE FINANCE AUDIT & REPORTING
// ==========================================

model ConfFinanceAuditLog {
    id          String   @id @default(cuid())
    confId      String
    actorUserId String?
    actorName   String
    action      String   // e.g. "PAYMENT_CREATED", "PAYMENT_FINAL_APPROVED"
    entityType  String   // "payment", "budget", "report", "member"
    entityId    String
    details     Json?    // before/after values or contextual data
    note        String?  @db.Text // rejection reason, comment, etc.
    createdAt   DateTime @default(now())

    conf ConfEvent @relation(fields: [confId], references: [id], onDelete: Cascade)

    @@index([confId])
    @@index([actorUserId])
    @@index([entityType, entityId])
    @@index([createdAt])
}

model ConfReport {
    id             String    @id @default(cuid())
    confId         String
    title          String
    description    String?   @db.Text
    dateFrom       DateTime?
    dateTo         DateTime?
    committeeScope String?   // filter by committee, null = all
    paymentTypes   String?   // "EXPENSE,INCOME" or single value
    generalComment String?   @db.Text
    status         String    @default("draft") // "draft", "published"
    createdByName  String?
    createdByUserId String?
    createdAt      DateTime  @default(now())
    updatedAt      DateTime  @updatedAt

    conf    ConfEvent         @relation(fields: [confId], references: [id], onDelete: Cascade)
    entries ConfReportEntry[]

    @@index([confId])
    @@index([status])
    @@index([createdAt])
}

model ConfReportEntry {
    id           String  @id @default(cuid())
    reportId     String
    paymentId    String?
    lineComment  String? @db.Text
    displayOrder Int     @default(0)

    report  ConfReport  @relation(fields: [reportId], references: [id], onDelete: Cascade)
    payment ConfPayment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

    @@index([reportId])
    @@index([paymentId])
}
