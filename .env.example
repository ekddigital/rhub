# =============================================================================
# EKD DIGITAL RESOURCE HUB - ENVIRONMENT VARIABLES (EXAMPLE)
# =============================================================================
# Copy this file to .env and fill in your actual values
# Never commit .env files with real credentials to version control

# -----------------------------------------------------------------------------
# Database Configuration (Required)
# -----------------------------------------------------------------------------
DATABASE_URL="mysql://username:password@localhost:3306/yourdb"

# -----------------------------------------------------------------------------
# Application Configuration
# -----------------------------------------------------------------------------
NODE_ENV="development"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# -----------------------------------------------------------------------------
# Next.js Configuration (Required for Production)
# -----------------------------------------------------------------------------
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="your-random-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# -----------------------------------------------------------------------------
# Optional Features
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_GA_MEASUREMENT_ID=""
# MAX_CONVERSIONS_PER_HOUR="100"
# MAX_FILE_SIZE_MB="10"
NEXT_TELEMETRY_DISABLED="1"

# -----------------------------------------------------------------------------
# YouTube Download Configuration (Optional - helps bypass bot detection)
# -----------------------------------------------------------------------------
# To get these values:
# 1. Open YouTube in your browser while logged in
# 2. Open DevTools (F12) > Application > Cookies > https://youtube.com
# 3. Copy the cookie string from the 'Cookie' column
# 4. For po_token and visitor_data, check Network tab for any YouTube request
#    and look in the request headers or response
# YOUTUBE_COOKIES="CONSENT=YES+...; VISITOR_INFO1_LIVE=...; YSC=..."
# YOUTUBE_PO_TOKEN="your-po-token-here"
# YOUTUBE_VISITOR_DATA="your-visitor-data-here"

# -----------------------------------------------------------------------------
# TTYD Terminal Configuration (Required for VPS remote features: doc conversion, Download Hub install)
# -----------------------------------------------------------------------------
# Base URL for the TTYD HTTP API (connect + execute). Same vars used by admin/setup and doc conversion.
TTYD_BASE_URL="https://ttyd.ekddigital.com"
# API key for TTYD authentication (format: api_<key>:<secret>)
TTYD_KEY="api_your-api-key:your-secret"
# Optional browser ttyd URL shown in Download Hub deps banner (not used for API calls)
# NEXT_PUBLIC_SERVER_TERMINAL_URL="https://mail.es.ekddigital.com:7681"
# Auto-install yt-dlp/ffmpeg on TTYD host when health is checked (default: off — use UI button or POST /api/tools/vid/setup)
# DOWNLOAD_HUB_AUTO_INSTALL_VIA_TTYD=false

# -----------------------------------------------------------------------------
# Admin API Configuration (Optional)
# -----------------------------------------------------------------------------
# API key for admin endpoints (install, setup, etc.)
# If not set, admin endpoints only work on localhost
# Generate with: openssl rand -hex 32
ADMIN_API_KEY=""

# -----------------------------------------------------------------------------
# Email Configuration (EKDSend API)
# -----------------------------------------------------------------------------
# Used for transactional emails (verification, password reset, judge invites)
EKDSEND_API_URL="https://es.ekddigital.com/api/v1"
EKDSEND_API_KEY=""